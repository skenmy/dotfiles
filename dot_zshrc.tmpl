{{- /* Modern zsh: antidote + starship + mise + atuin + fzf + zoxide */ -}}
# ---- History ----
HISTFILE="$XDG_STATE_HOME/zsh/history"
HISTSIZE=1000000
SAVEHIST=1000000
mkdir -p "$(dirname "$HISTFILE")"
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_VERIFY INC_APPEND_HISTORY SHARE_HISTORY

# ---- Options ----
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS NO_BEEP PROMPT_SUBST
setopt COMPLETE_IN_WORD ALWAYS_TO_END

# ---- Completion ----
autoload -Uz compinit
ZSH_COMPDUMP="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
mkdir -p "$(dirname "$ZSH_COMPDUMP")"
compinit -d "$ZSH_COMPDUMP"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':fzf-tab:*' fzf-flags --height=50% --layout=reverse --border

# ---- Antidote (plugin manager) ----
{{- if eq .chezmoi.os "darwin" }}
ANTIDOTE_HOME="$(brew --prefix)/opt/antidote/share/antidote"
{{- else }}
ANTIDOTE_HOME="${ANTIDOTE_HOME:-$HOME/.antidote}"
[ -d "$ANTIDOTE_HOME" ] || git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_HOME"
{{- end }}
if [ -f "$ANTIDOTE_HOME/antidote.zsh" ]; then
    source "$ANTIDOTE_HOME/antidote.zsh"
    antidote load "$HOME/.zsh_plugins.txt"
fi

# ---- Starship prompt ----
command -v starship >/dev/null && eval "$(starship init zsh)"

# ---- Tooling: mise (runtime versions) ----
command -v mise >/dev/null && eval "$(mise activate zsh)"

# ---- Tooling: fzf (fuzzy finder) ----
if command -v fzf >/dev/null; then
    source <(fzf --zsh) 2>/dev/null || true
    export FZF_DEFAULT_OPTS="--height=50% --layout=reverse --border --info=inline"
    command -v fd >/dev/null && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

# ---- Tooling: atuin (history sync) ----
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# ---- Tooling: direnv ----
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# ---- Tooling: gh (completion) ----
command -v gh >/dev/null && eval "$(gh completion -s zsh)"

# ---- Aliases ----
if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first --icons'
    alias l='eza -lah --git --group-directories-first --icons'
    alias la='eza -lah --git --group-directories-first --icons'
    alias ll='eza -lh --git --group-directories-first --icons'
    alias tree='eza --tree --git-ignore --icons'
fi
command -v bat >/dev/null && alias cat='bat --paging=never'
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gco='git checkout'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'
alias glog='git log --oneline --graph --decorate --all'
alias k='kubectl'
alias tf='terraform'
alias lzg='lazygit'
alias vi='nvim'
alias vim='nvim'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mkcd='function _mkcd(){ mkdir -p "$1" && cd "$1"; };_mkcd'
alias myip='curl -s ifconfig.me'
alias serve='python3 -m http.server'
alias dco='docker compose'
alias dps='docker ps --format "table {{ "{{" }}.Names{{ "}}" }}\t{{ "{{" }}.Image{{ "}}" }}\t{{ "{{" }}.Status{{ "}}" }}"'

# ---- Key bindings ----
bindkey -e
bindkey '^[[A' history-substring-search-up   2>/dev/null
bindkey '^[[B' history-substring-search-down 2>/dev/null
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

{{- if eq .chezmoi.os "darwin" }}

# ---- macOS: legacy/local toolchains preserved ----
# Node/Python/Go/Rust versions are managed by mise (sourced higher up).
# To migrate from nvm on a box that still has it:
#   for v in $(ls ~/.nvm/versions/node 2>/dev/null); do mise install node@${v#v}; done
#   mise use -g node@lts
#   rm -rf ~/.nvm
# After that nvm is gone and there's nothing to source here.

# Bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
[ -d "$ANDROID_HOME/emulator" ] && export PATH="$PATH:$ANDROID_HOME/emulator"
[ -d "$ANDROID_HOME/platform-tools" ] && export PATH="$PATH:$ANDROID_HOME/platform-tools"

# Java (Zulu 17)
[ -d "/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home" ] && \
    export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"

# flux completion
command -v flux >/dev/null && . <(flux completion zsh)

# iTerm2 shell integration (works in Ghostty too)
test -e "$HOME/.iterm2_shell_integration.zsh" && source "$HOME/.iterm2_shell_integration.zsh"
{{- end }}

# ---- zoxide (must be last — needs the final PATH) ----
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# ---- Random tip on every new interactive shell ----
# Pick a random non-comment, non-blank line from ~/.config/dotfiles/tips.
# Suppress with `export DOTFILES_NO_TIP=1` in ~/.zshrc.local.
if [[ -o interactive ]] && [[ -z "${DOTFILES_NO_TIP:-}" ]] && [[ -f "$HOME/.config/dotfiles/tips" ]]; then
    _tip="$(awk 'BEGIN{srand()} /^[^#]/ && NF {a[++n]=$0} END{if(n)print a[int(rand()*n)+1]}' "$HOME/.config/dotfiles/tips")"
    [[ -n "$_tip" ]] && print -P "%F{yellow}💡%f %B$_tip%b"
    unset _tip
fi

# ---- Local overrides (gitignored) ----
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
