{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Fragment hashes — re-run whenever any Brewfile source changes:
#   template: {{ include "Brewfile.tmpl" | sha256sum }}
#   common:   {{ include ".chezmoitemplates/brew/common.Brewfile" | sha256sum }}
#   gui:      {{ include ".chezmoitemplates/brew/gui.Brewfile" | sha256sum }}
#   personal: {{ include ".chezmoitemplates/brew/personal.Brewfile" | sha256sum }}
#   work:     {{ include ".chezmoitemplates/brew/work.Brewfile" | sha256sum }}
#
# Re-runs `brew bundle` whenever any fragment changes — so adding
# `brew "foo"` to a fragment and pushing is enough to get foo installed on every box
# on the next apply (chezmoi-update timer or manual `chezmoi apply`).
set -uo pipefail

command -v brew >/dev/null 2>&1 || { echo "brew not on PATH; skipping bundle"; exit 0; }

echo "==> brew bundle (Brewfile changed)"
brew bundle --file="$HOME/Brewfile" {{ if default false .headless }}--no-upgrade{{ end }} || \
    echo "!! brew bundle reported errors; check 'brew bundle check --verbose' for details"
{{- end }}
