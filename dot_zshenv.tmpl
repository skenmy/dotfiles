{{- /* Loaded for every zsh; keep minimal and login-safe. */ -}}
# XDG base dirs
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Editor defaults
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-FRX"

# Rust (if installed)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Local user bin
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# GPG (so signing prompts attach to current TTY)
export GPG_TTY=$(tty)

# zoxide: silence the "initialized at the end" doctor warning. It's a false
# positive in non-interactive/tooling shells (e.g. Claude Code's Bash tool)
# that cd into the working dir out-of-band, after zoxide's hook is set up.
# zoxide is genuinely last in .zshrc, so the check adds only noise.
export _ZO_DOCTOR=0
