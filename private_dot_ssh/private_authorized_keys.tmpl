{{- /*
  Auto-populated from GitHub @{{ .githubUser }} at chezmoi apply time.
  Personal machines only — unmanaged on work boxes via .chezmoiignore.
  To add a per-host extra key, append to ~/.ssh/authorized_keys.local.
*/ -}}
# Public keys for @{{ .githubUser }} (synced from github.com/{{ .githubUser }}.keys)
{{ range gitHubKeys .githubUser -}}
{{ .Key }}
{{ end -}}

{{- $localExtra := joinPath .chezmoi.homeDir ".ssh" "authorized_keys.local" }}
{{- if stat $localExtra }}

# Local extras
{{ include $localExtra }}
{{- end }}
