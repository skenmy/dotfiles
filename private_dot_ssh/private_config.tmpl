# ~/.ssh/config — sensible defaults across all hosts

# Local per-host overrides, included FIRST so they win (ssh is first-match-wins).
Include ~/.ssh/config.local

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 30
    HashKnownHosts no
    StrictHostKeyChecking accept-new
    VisualHostKey yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- if .work }}
    # Work machine — use the 1Password SSH agent.
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
    # Personal machine — use the Bitwarden Desktop SSH agent.
    # Enable it in Bitwarden Desktop → Settings → SSH Agent.
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
{{- end }}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{- if .work }}
    # Work Linux box — 1Password CLI agent socket.
    IdentityAgent "~/.1password/agent.sock"
{{- else }}
    # Personal Linux box — Bitwarden Desktop SSH agent socket.
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
{{- end }}
{{- end }}

# GitHub
Host github.com gh
    HostName github.com
    User git
    PreferredAuthentications publickey
{{- if .work }}
    # Work: pin the personal account to its on-disk key, bypassing the agent.
    # IdentitiesOnly excludes the agent's keys, so auth uses exactly this key.
    IdentityFile ~/.ssh/id_ed25519_skenmy
    IdentitiesOnly yes

# EIT EMU — same github.com, different on-disk key. Use via git@github-eit:org/repo
# for the ~/code/eit tree (see eitclone()).
Host github-eit
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_eit
    IdentitiesOnly yes
{{- end }}
