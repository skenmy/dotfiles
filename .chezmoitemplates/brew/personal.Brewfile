# ── personal.Brewfile — personal machines only (work = false) ────────
# Media, games, the personal tailnet and hobby tooling. Applied regardless
# of the headless flag; move a line to gui.Brewfile if it needs a display
# on every profile.

brew "streamlink"
brew "whisper-cpp"
brew "yt-dlp"
brew "ollama"

cask "spotify"
cask "telegram"
cask "battle-net"
cask "tailscale-app"        # work boxes use the employer-managed Tailscale
cask "openclaw"

# auto-synced from Mac on 2026-09-25
brew "whisper.cpp"
cask "boswell"
tap "skenmy/boswell"
