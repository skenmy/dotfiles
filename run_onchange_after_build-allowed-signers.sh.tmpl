#!/usr/bin/env bash
# Rebuild ~/.ssh/allowed_signers so SSH-signed commits/tags verify locally.
# Re-fires whenever the rendered values below change (email / work flag).
#   email={{ .email }} work={{ .work }}
# Also re-fires once the key files appear (bootstrap writes them after the first apply):
#   personal key present: {{ if stat (joinPath .chezmoi.homeDir ".ssh" (printf "%s.pub" (ternary "id_ed25519_skenmy" "id_ed25519" .work))) }}yes{{ else }}no{{ end }}
{{- if .work }}
#   eit key present: {{ if stat (joinPath .chezmoi.homeDir ".ssh" "id_ed25519_eit.pub") }}yes{{ else }}no{{ end }}
{{- end }}
set -euo pipefail

out="$HOME/.ssh/allowed_signers"
tmp="$(mktemp)"

personal_key="$HOME/.ssh/{{ if .work }}id_ed25519_skenmy{{ else }}id_ed25519{{ end }}.pub"
if [ -f "$personal_key" ]; then
    printf '%s %s\n' "{{ .email }}" "$(awk '{print $1, $2}' "$personal_key")" >> "$tmp"
fi
{{- if .work }}
eit_key="$HOME/.ssh/id_ed25519_eit.pub"
if [ -f "$eit_key" ]; then
    printf '{{ .workEmail }} %s\n' "$(awk '{print $1, $2}' "$eit_key")" >> "$tmp"
fi
{{- end }}

mkdir -p "$HOME/.ssh"
mv "$tmp" "$out"
chmod 644 "$out"
