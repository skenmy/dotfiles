# dotfiles-brew-sync ignore list — one extended-regex per line.
# Matched against rendered Brewfile lines, so anchor with ^ and use quotes.
#
# Examples:
#   ^cask "firefox"$
#   ^brew "experimental-tool"$
#
# Lines starting with # are comments and ignored.

# Duplicates: the codex cask ships the CLI; terraform (common.Brewfile) owns bin/terraform
^brew "codex"$
^brew "tfenv"$

# Self-updating, root-owned app: brew can't upgrade it unattended (needs sudo)
^cask "chatgpt"$
