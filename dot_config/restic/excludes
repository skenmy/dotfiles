# Paths excluded from `restic backup ~`. Lines starting with # are ignored.
# Matches restic's pattern syntax: https://restic.readthedocs.io/en/stable/040_backup.html#excluding-files

# Caches (regenerated automatically; never worth backing up)
.cache
Library/Caches
Library/Application Support/Code/Cache*
Library/Application Support/Code/CachedData
Library/Application Support/Code/Service Worker
Library/Application Support/Cursor/Cache*
Library/Application Support/Firefox/Profiles/*/cache2
Library/Application Support/Google/Chrome/*/Cache
Library/Containers/*/Data/Library/Caches

# Build artefacts
node_modules
.venv
__pycache__
*.pyc
target
build
dist
.next
.turbo
.parcel-cache
.pytest_cache
.mypy_cache
.ruff_cache
.tox

# Cloud / drive sync — the *cloud* is the canonical copy; local is just cache.
Library/CloudStorage
Library/Mobile Documents
Dropbox
Google Drive

# OS junk
.DS_Store
.Trash
Library/Logs
Library/Mail
*.tmp

# Big stuff usually re-downloadable
Downloads
Movies
Music

# ── iCloud-backed Apple apps ───────────────────────────────────────
# iCloud Photos: kept in the backup deliberately ("can't hurt" — and
# you haven't confirmed iCloud sync state). Uncomment if you ever
# verify iCloud Photos is on and want to reclaim the GBs.
# Pictures/Photos Library.photoslibrary
# Apple Notes: in CloudKit if iCloud Notes is on. Re-include if not.
Library/Group Containers/group.com.apple.notes
Library/Containers/com.apple.Notes
# iMessage: in iCloud if "Messages in iCloud" is enabled. Comment back
# in if not — local SQLite is the only copy then.
Library/Messages

