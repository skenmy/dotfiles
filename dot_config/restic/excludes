Library/Application Support/Cursor/GPUCache
Library/Application Support/Cursor/Service Worker
Library/Application Support/Cursor/User/workspaceStorage
Library/Application Support/Cursor/User/History

# ── Things you probably DO want to keep (NOT excluded) ───────────
# ~/Documents       — irreplaceable user data
# ~/Desktop         — active workspace
# ~/code            — projects (git remotes don't capture uncommitted work)
# ~/.ssh            — known_hosts + agent socket configs
# ~/.gnupg          — keyring + trust DB
# ~/.config         — chezmoi-managed configs (small)
# ~/.local/share/atuin/key — atuin encryption key

# ── Opt-in: uncomment if these don't matter on this box ──────────
# Parallels — VM disk images, often 100GB+. UNIQUE state lives inside;
# only exclude if you can re-build the VM from scratch.
# Parallels
# Library/Group Containers/4C6364ACXT.com.parallels.desktop.appstore

# Anything matching `CACHEDIR.TAG` is auto-skipped via --exclude-caches.
