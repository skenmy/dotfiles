# Copy to ~/.config/restic/env and fill in. chmod 0600 it.
# Real values can come from Bitwarden — see seed-bitwarden.sh + bootstrap.sh.

# Repository URL — restic supports many backends:
#   b2:bucket-name:prefix
#   s3:s3.amazonaws.com/bucket
#   sftp:user@host:/path
#   rest:https://restic-server.example.com/repo
RESTIC_REPOSITORY=b2:CHANGE-ME-BUCKET:laptop

# Either RESTIC_PASSWORD or RESTIC_PASSWORD_FILE. Both refer to the
# *repository* password — encrypts the backup at rest. Lose it and your
# backups are unrecoverable; back it up to Bitwarden.
RESTIC_PASSWORD=CHANGE-ME

# Backend-specific creds — uncomment the ones you use.
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Performance tweaks (sane defaults; override if needed):
# RESTIC_CACHE_DIR=$HOME/.cache/restic
# RESTIC_PACK_SIZE=16
