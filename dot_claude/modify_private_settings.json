#!/bin/sh
# chezmoi modify_ script for ~/.claude/settings.json. Claude Code owns the rest of
# this file (permissions, plugins, drafts — per-machine and not for a public repo),
# so we only set statusLine, the default subagent model (sonnet; see ~/.claude/CLAUDE.md),
# and add the TypeSafe + Codex plugins if missing (a local disable is kept).
# The Codex plugin's hooks run node and it drives the codex CLI, so it's added only where both exist.
# chezmoi writes whatever this prints, so on any failure echo the input back.
in=$(cat)
[ -n "$in" ] || in='{}'
codex=false
command -v codex >/dev/null 2>&1 && command -v node >/dev/null 2>&1 && codex=true
if command -v jq >/dev/null 2>&1 &&
   out=$(printf '%s' "$in" | jq --indent 2 --argjson codex "$codex" '
     def ensure(k; v): .[k] |= (if . == null then v else . end);
     .statusLine = {"type": "command", "command": "bash ~/.claude/statusline.sh"}
     | .env.CLAUDE_CODE_SUBAGENT_MODEL = "sonnet"
     | .extraKnownMarketplaces |= ensure("typesafe-ai"; {"source": {"source": "github", "repo": "typesafe-ai/skills"}})
     | .enabledPlugins |= ensure("typesafe@typesafe-ai"; true)
     | if $codex then
         .extraKnownMarketplaces |= ensure("openai-codex"; {"source": {"source": "github", "repo": "openai/codex-plugin-cc"}})
         | .enabledPlugins |= ensure("codex@openai-codex"; true)
       else . end'); then
  printf '%s\n' "$out"
else
  printf '%s' "$in"
fi
