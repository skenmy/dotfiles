#!/usr/bin/env bash
#
# Nightly: detect brews/casks installed locally that aren't in any dotfiles
# Brewfile fragment, append them to this machine's target fragment, commit
# (signed) + push. Other boxes pick the change up via the daily
# chezmoi-update timer.
#
# Fragments live in <source>/.chezmoitemplates/brew/{common,gui,personal}.Brewfile
# and are rendered into ~/Brewfile by Brewfile.tmpl. Drift is computed
# against the UNION of all fragments so a package gated to another profile
# is never re-added; new lines go to the fragment named in
#     ~/.config/dotfiles/brew-sync-target      (chezmoi-managed; default common)
#
# Append-only by design:
#   - New local install → propagates to every Mac in that profile tomorrow.
#   - Local uninstall → does NOT remove a line (do that by hand in a PR).
#
# Per-host exceptions: one extended-regex per line in
#     ~/.config/dotfiles/brew-sync-ignore
# matched against normalised `kind "name"` lines (e.g. `^cask "firefox"$`).
#
# Commits are signed with the machine's normal git config. If signing fails
# (key unavailable to launchd), the change is left staged and retried on the
# next run — never committed unsigned.
#
# Logs at ~/.local/state/dotfiles-brew-sync/last.log. Always exits 0.

set -uo pipefail

LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-brew-sync"
LOG="$LOGDIR/last.log"
mkdir -p "$LOGDIR"

ts() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
say() { printf "[%s] %s\n" "$(ts)" "$*" | tee -a "$LOG"; }

HOST="$(hostname -s 2>/dev/null || hostname)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

command -v brew    >/dev/null || { say "brew not on PATH; aborting"; exit 0; }
command -v chezmoi >/dev/null || { say "chezmoi not on PATH; aborting"; exit 0; }

SRC="$(chezmoi source-path 2>/dev/null || echo "$HOME/.local/share/chezmoi")"
FRAG_DIR="$SRC/.chezmoitemplates/brew"
[ -d "$FRAG_DIR" ] || { say "no fragment dir at $FRAG_DIR; aborting"; exit 0; }

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
TARGET="$(tr -d '[:space:]' < "$CONF_DIR/brew-sync-target" 2>/dev/null || true)"
TARGET="${TARGET:-common}"
TARGET_FILE="$FRAG_DIR/$TARGET.Brewfile"
[ -f "$TARGET_FILE" ] || { say "target fragment $TARGET_FILE does not exist; aborting"; exit 0; }

# Reduce any Brewfile line to its identity: `kind "name"`. Drops trailing
# comments, options (`, args: [...]`) and whitespace so textual variants of
# the same package never look like drift.
normalise() {
    grep -E '^[[:space:]]*(brew|cask|tap|mas)[[:space:]]+"[^"]+"' \
        | sed -E 's/^[[:space:]]*(brew|cask|tap|mas)[[:space:]]+"([^"]+)".*$/\1 "\2"/' \
        | sort -u
}

commit_and_push() {
    # $1 = commit message. Signed with the normal git config; no fallback.
    cd "$SRC" || return 1
    if ! git pull --rebase --autostash >>"$LOG" 2>&1; then
        # Usually another Mac appended to the same fragment tonight and the
        # autostash/rebase conflicted. The clone is disposable: drop our append,
        # go back to origin/main, and let tomorrow's run re-detect the drift.
        # Leaving the rebase half-done would break every nightly chezmoi update.
        say "git pull failed (conflict?) — resetting source clone to origin/main; drift re-detected tomorrow"
        git rebase --abort >/dev/null 2>&1 || true
        git checkout -q -f main 2>/dev/null || true
        git fetch -q origin && git reset -q --hard origin/main
        while git stash list | grep -q .; do git stash drop -q; done
        return 1
    fi
    git add -- "$FRAG_DIR"
    if ! git commit -m "$1" >>"$LOG" 2>&1; then
        say "git commit failed (signing key unavailable to launchd?) — change left staged, retry tomorrow"
        return 1
    fi
    git push >>"$LOG" 2>&1 || { say "git push failed — local commit kept"; return 1; }
    say "pushed: $1"
}

# 0. Finish a previous run that appended but could not commit.
if [ -n "$(git -C "$SRC" status --porcelain -- "$FRAG_DIR")" ]; then
    say "pending fragment change from an earlier run — retrying commit"
    commit_and_push "brew-sync: pending package(s) from $HOST" || exit 0
fi

TMP="$(mktemp)"
trap 'rm -f "$TMP" "${TMP}.dump"' EXIT

# 1. Dump current local brew state.
brew bundle dump --force --no-vscode --no-restart --file="${TMP}.dump" 2>>"$LOG"

# 2. Normalise the union of all fragments and the dump.
existing="$(cat "$FRAG_DIR"/*.Brewfile | normalise)"
current="$(normalise < "${TMP}.dump")"

# 3. Apply the ignore list to the current state.
IGNORE_FILE="$CONF_DIR/brew-sync-ignore"
if [ -f "$IGNORE_FILE" ]; then
    patterns="$(grep -Ev '^[[:space:]]*(#|$)' "$IGNORE_FILE" || true)"
    [ -n "$patterns" ] && current="$(printf '%s\n' "$current" | grep -E -v -f <(printf '%s\n' "$patterns") || true)"
fi

# 4. What's installed locally but in no fragment?
new_lines="$(comm -23 <(printf '%s\n' "$current") <(printf '%s\n' "$existing"))"

if [ -z "$new_lines" ]; then
    say "no drift — fragments in sync with local brew state"
    exit 0
fi

count="$(printf '%s\n' "$new_lines" | wc -l | tr -d ' ')"
say "drift detected on $HOST — adding $count line(s) to $TARGET.Brewfile"
printf '%s\n' "$new_lines" | sed 's/^/    + /' | tee -a "$LOG"

# 5. Append under a dated header.
{
    printf '\n# auto-synced from %s on %s\n' "$HOST" "$(date +%Y-%m-%d)"
    printf '%s\n' "$new_lines"
} >> "$TARGET_FILE"

# 6. Commit (signed) and push.
commit_and_push "brew-sync: $count new package(s) from $HOST → $TARGET" || exit 0
exit 0
